# Backend-only settings. APP_ENV, ports and storage credentials live in ../.env;
# DATABASE_URL, REDIS_URL and MONGODB_URL are assembled from them unless set here.
HOST=0.0.0.0
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000
JSON_BODY_LIMIT=1mb
JWT_ACCESS_SECRET=local-development-access-secret-not-for-real-use
JWT_REFRESH_SECRET=local-development-refresh-secret-not-for-real-use
SEED_USER_PASSWORD=practice-demo-password
# The production stack is a training stand: let the seed fill it on purpose.
SEED_ALLOW_PRODUCTION=true
REDIS_KEY_PREFIX=crm:
CACHE_TTL_SECONDS=300
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_MAX_REQUESTS=10
EVENT_LOG_RETENTION_DAYS=90
WS_PATH=/api/v1/realtime

# Everything below is optional. Left unset, the AI provider is the built-in
# mock, the delivery client is the built-in stub, and the cache is backed by
# Redis — exactly the behaviour a fresh checkout has always had.
# DELIVERY_BASE_URL=
# DELIVERY_API_KEY=
# DELIVERY_TIMEOUT_MS=5000
# DELIVERY_MAX_ATTEMPTS=3
# DELIVERY_BASE_BACKOFF_MS=100
# DELIVERY_MAX_BACKOFF_MS=1000
# DELIVERY_FAILURE_THRESHOLD=5
# DELIVERY_COOLDOWN_MS=30000
# DELIVERY_QUOTE_CACHE_TTL_SECONDS=60
# AI_ENDPOINT_URL=
# AI_API_KEY=
# AI_MODEL=
# AI_TIMEOUT_MS=10000
# AI_MAX_ATTEMPTS=2
# AI_MAX_TOKENS=400
# AI_MAX_INPUT_CHARS=4000
# AI_CACHE_TTL_SECONDS=300
# INFRA_PROFILE selects a whole family of implementations at once instead of
# leaving each dependency to notice its own setting: `offline` forces the mock
# AI provider, the stub delivery transport and a cache with no external store,
# regardless of the settings above; `live` (or leaving this unset) is today's
# behaviour, where each dependency still decides for itself.
# INFRA_PROFILE=live
