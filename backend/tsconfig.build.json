{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "allowJs": true,
    "types": ["node"],
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true
  },
  "include": ["src/**/*.ts", "src/**/*.cjs"],
  "exclude": ["src/**/*.test.ts", "src/**/*.spec.ts"]
}
