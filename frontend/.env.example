# Base URL of the API this client talks to. Same contract for either backend.
# The default goes through the stack's nginx, so it works whichever backend runs.
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# WebSocket endpoint used for live updates. Leave empty to disable the channel.
NEXT_PUBLIC_WS_URL=ws://localhost:8080/api/v1/realtime