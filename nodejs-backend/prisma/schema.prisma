generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PermissionScope {
  ALL
  OWN
}

enum DealStage {
  LEAD
  QUALIFIED
  PROPOSAL
  WON
  LOST
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  PAID
  FULFILLED
  CANCELLED
}

enum StockMovementType {
  RECEIPT
  ISSUE
  RESERVATION
  RELEASE
  ADJUSTMENT
}

enum TicketChannel {
  EMAIL
  PHONE
  CHAT
  WEB
}

enum TicketStatus {
  NEW
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum CallDirection {
  INBOUND
  OUTBOUND
}

enum CallDisposition {
  ANSWERED
  NO_ANSWER
  BUSY
  FAILED
  VOICEMAIL
}

enum TransactionDirection {
  CREDIT
  DEBIT
}

enum PaymentMatchStatus {
  UNMATCHED
  SUGGESTED
  MATCHED
  IGNORED
}

model User {
  id                  String                @id @default(uuid()) @db.Uuid
  email               String                @unique @db.VarChar(320)
  passwordHash        String                @map("password_hash") @db.VarChar(255)
  name                String                @db.VarChar(120)
  isActive            Boolean               @default(true) @map("is_active")
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions            Session[]
  userRoles           UserRole[]
  contacts            Contact[]             @relation("ContactOwner")
  deals               Deal[]                @relation("DealOwner")
  auditLogs           AuditLog[]            @relation("AuditActor")
  orders              Order[]               @relation("OrderOwner")
  stockMovements      StockMovement[]       @relation("StockActor")
  settingEdits        OrganizationSetting[] @relation("SettingEditor")
  tickets             Ticket[]              @relation("TicketOwner")
  ticketsAssigned     Ticket[]              @relation("TicketAssignee")
  ticketStatusChanges TicketStatusLog[]     @relation("TicketStatusActor")
  calls               Call[]                @relation("CallOwner")
  statementImports    BankStatement[]       @relation("StatementImporter")
  transactionMatches  BankTransaction[]     @relation("TransactionMatcher")

  @@index([isActive])
  @@map("users")
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  ipAddress String?   @map("ip_address") @db.Inet
  userAgent String?   @map("user_agent") @db.VarChar(512)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("sessions")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique @db.VarChar(64)
  description String?          @db.VarChar(255)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  userRoles   UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique @db.VarChar(100)
  description String?          @db.VarChar(255)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  roles       RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String          @map("role_id") @db.Uuid
  permissionId String          @map("permission_id") @db.Uuid
  scope        PermissionScope
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  role         Role            @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission      @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Contact {
  id        String    @id @default(uuid()) @db.Uuid
  ownerId   String    @map("owner_id") @db.Uuid
  firstName String    @map("first_name") @db.VarChar(80)
  lastName  String    @map("last_name") @db.VarChar(80)
  email     String?   @db.VarChar(320)
  phone     String?   @db.VarChar(32)
  company   String?   @db.VarChar(160)
  notes     String?   @db.Text
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  owner     User      @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  deals     Deal[]
  orders    Order[]
  tickets   Ticket[]
  calls     Call[]

  @@index([ownerId, deletedAt])
  @@index([lastName, firstName])
  @@index([email])
  @@index([company])
  @@map("contacts")
}

model Deal {
  id                String    @id @default(uuid()) @db.Uuid
  ownerId           String    @map("owner_id") @db.Uuid
  contactId         String?   @map("contact_id") @db.Uuid
  title             String    @db.VarChar(160)
  stage             DealStage @default(LEAD)
  amount            Decimal   @default(0) @db.Decimal(14, 2)
  currency          String    @default("USD") @db.Char(3)
  probability       Int       @default(10)
  version           Int       @default(1)
  expectedCloseDate DateTime? @map("expected_close_date") @db.Date
  closedAt          DateTime? @map("closed_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(3)
  owner             User      @relation("DealOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  contact           Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  orders            Order[]
  calls             Call[]

  @@index([ownerId, stage, deletedAt])
  @@index([contactId])
  @@index([stage, expectedCloseDate])
  @@index([deletedAt])
  @@map("deals")
}

model Product {
  id          String          @id @default(uuid()) @db.Uuid
  sku         String          @unique @db.VarChar(64)
  name        String          @db.VarChar(160)
  description String?         @db.Text
  category    String?         @db.VarChar(80)
  unitPrice   Decimal         @default(0) @map("unit_price") @db.Decimal(14, 2)
  currency    String          @default("USD") @db.Char(3)
  isActive    Boolean         @default(true) @map("is_active")
  version     Int             @default(1)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime?       @map("deleted_at") @db.Timestamptz(3)
  orderItems  OrderItem[]
  stockLevels StockLevel[]
  movements   StockMovement[]

  @@index([category, isActive])
  @@index([name])
  @@index([deletedAt])
  @@map("products")
}

model Order {
  id               String            @id @default(uuid()) @db.Uuid
  orderNumber      String            @unique @map("order_number") @db.VarChar(32)
  ownerId          String            @map("owner_id") @db.Uuid
  contactId        String?           @map("contact_id") @db.Uuid
  dealId           String?           @map("deal_id") @db.Uuid
  status           OrderStatus       @default(DRAFT)
  currency         String            @default("USD") @db.Char(3)
  subtotal         Decimal           @default(0) @db.Decimal(14, 2)
  discountTotal    Decimal           @default(0) @map("discount_total") @db.Decimal(14, 2)
  taxTotal         Decimal           @default(0) @map("tax_total") @db.Decimal(14, 2)
  total            Decimal           @default(0) @db.Decimal(14, 2)
  notes            String?           @db.Text
  version          Int               @default(1)
  placedAt         DateTime?         @map("placed_at") @db.Timestamptz(3)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt        DateTime?         @map("deleted_at") @db.Timestamptz(3)
  owner            User              @relation("OrderOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  contact          Contact?          @relation(fields: [contactId], references: [id], onDelete: SetNull)
  deal             Deal?             @relation(fields: [dealId], references: [id], onDelete: SetNull)
  items            OrderItem[]
  bankTransactions BankTransaction[]

  @@index([ownerId, status, deletedAt])
  @@index([contactId])
  @@index([dealId])
  @@index([status, placedAt])
  @@index([deletedAt])
  @@map("orders")
}

model OrderItem {
  id        String   @id @default(uuid()) @db.Uuid
  orderId   String   @map("order_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  // Snapshots keep a historical order readable after the catalogue changes.
  sku       String   @db.VarChar(64)
  name      String   @db.VarChar(160)
  quantity  Int
  unitPrice Decimal  @map("unit_price") @db.Decimal(14, 2)
  lineTotal Decimal  @map("line_total") @db.Decimal(14, 2)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([orderId, productId])
  @@index([productId])
  @@map("order_items")
}

model Warehouse {
  id        String          @id @default(uuid()) @db.Uuid
  code      String          @unique @db.VarChar(32)
  name      String          @db.VarChar(120)
  isActive  Boolean         @default(true) @map("is_active")
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  stock     StockLevel[]
  movements StockMovement[]

  @@map("warehouses")
}

model StockLevel {
  id               String    @id @default(uuid()) @db.Uuid
  warehouseId      String    @map("warehouse_id") @db.Uuid
  productId        String    @map("product_id") @db.Uuid
  quantityOnHand   Int       @default(0) @map("quantity_on_hand")
  quantityReserved Int       @default(0) @map("quantity_reserved")
  version          Int       @default(1)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  warehouse        Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product          Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, productId])
  @@index([productId])
  @@map("stock_levels")
}

model StockMovement {
  id            String            @id @default(uuid()) @db.Uuid
  warehouseId   String            @map("warehouse_id") @db.Uuid
  productId     String            @map("product_id") @db.Uuid
  type          StockMovementType
  quantity      Int
  referenceType String?           @map("reference_type") @db.VarChar(64)
  referenceId   String?           @map("reference_id") @db.Uuid
  actorId       String?           @map("actor_id") @db.Uuid
  note          String?           @db.VarChar(255)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  warehouse     Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  product       Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  actor         User?             @relation("StockActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([warehouseId, productId, createdAt])
  @@index([referenceType, referenceId])
  @@index([type, createdAt])
  @@map("stock_movements")
}

model OrganizationSetting {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.VarChar(100)
  value       Json
  description String?  @db.VarChar(255)
  updatedById String?  @map("updated_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy   User?    @relation("SettingEditor", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("organization_settings")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String   @db.VarChar(64)
  entityType String   @map("entity_type") @db.VarChar(64)
  entityId   String?  @map("entity_id") @db.Uuid
  changes    Json?
  metadata   Json?
  ipAddress  String?  @map("ip_address") @db.Inet
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model Ticket {
  id         String            @id @default(uuid()) @db.Uuid
  number     String            @unique @db.VarChar(16)
  subject    String            @db.VarChar(200)
  body       String            @db.Text
  channel    TicketChannel
  status     TicketStatus      @default(NEW)
  priority   TicketPriority    @default(NORMAL)
  ownerId    String            @map("owner_id") @db.Uuid
  contactId  String?           @map("contact_id") @db.Uuid
  assigneeId String?           @map("assignee_id") @db.Uuid
  version    Int               @default(1)
  openedAt   DateTime          @default(now()) @map("opened_at") @db.Timestamptz(3)
  resolvedAt DateTime?         @map("resolved_at") @db.Timestamptz(3)
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt  DateTime?         @map("deleted_at") @db.Timestamptz(3)
  owner      User              @relation("TicketOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  contact    Contact?          @relation(fields: [contactId], references: [id], onDelete: SetNull)
  assignee   User?             @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  statusLogs TicketStatusLog[]

  @@index([ownerId, status, deletedAt])
  @@index([status, priority])
  @@index([contactId])
  @@index([assigneeId])
  @@index([deletedAt])
  @@map("tickets")
}

model TicketStatusLog {
  id          String        @id @default(uuid()) @db.Uuid
  ticketId    String        @map("ticket_id") @db.Uuid
  fromStatus  TicketStatus? @map("from_status")
  toStatus    TicketStatus  @map("to_status")
  changedById String?       @map("changed_by_id") @db.Uuid
  note        String?       @db.VarChar(500)
  changedAt   DateTime      @default(now()) @map("changed_at") @db.Timestamptz(3)
  ticket      Ticket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  changedBy   User?         @relation("TicketStatusActor", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([ticketId, changedAt])
  @@map("ticket_status_logs")
}

model Call {
  id              String          @id @default(uuid()) @db.Uuid
  externalId      String          @unique @map("external_id") @db.VarChar(64)
  direction       CallDirection
  disposition     CallDisposition
  fromNumber      String          @map("from_number") @db.VarChar(32)
  toNumber        String          @map("to_number") @db.VarChar(32)
  startedAt       DateTime        @map("started_at") @db.Timestamptz(3)
  durationSeconds Int             @default(0) @map("duration_seconds")
  ownerId         String?         @map("owner_id") @db.Uuid
  contactId       String?         @map("contact_id") @db.Uuid
  dealId          String?         @map("deal_id") @db.Uuid
  recordingUrl    String?         @map("recording_url") @db.VarChar(512)
  notes           String?         @db.Text
  version         Int             @default(1)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime?       @map("deleted_at") @db.Timestamptz(3)
  owner           User?           @relation("CallOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  contact         Contact?        @relation(fields: [contactId], references: [id], onDelete: SetNull)
  deal            Deal?           @relation(fields: [dealId], references: [id], onDelete: SetNull)

  @@index([startedAt])
  @@index([ownerId, startedAt])
  @@index([contactId])
  @@index([dealId])
  @@index([direction, disposition])
  @@index([deletedAt])
  @@map("calls")
}

model BankStatement {
  id             String            @id @default(uuid()) @db.Uuid
  externalId     String            @unique @map("external_id") @db.VarChar(64)
  accountLabel   String            @map("account_label") @db.VarChar(64)
  periodStart    DateTime          @map("period_start") @db.Date
  periodEnd      DateTime          @map("period_end") @db.Date
  openingBalance Decimal           @default(0) @map("opening_balance") @db.Decimal(14, 2)
  closingBalance Decimal           @default(0) @map("closing_balance") @db.Decimal(14, 2)
  currency       String            @default("USD") @db.Char(3)
  importedById   String?           @map("imported_by_id") @db.Uuid
  importedAt     DateTime          @default(now()) @map("imported_at") @db.Timestamptz(3)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  importedBy     User?             @relation("StatementImporter", fields: [importedById], references: [id], onDelete: SetNull)
  transactions   BankTransaction[]

  @@index([periodStart, periodEnd])
  @@map("bank_statements")
}

model BankTransaction {
  id                  String               @id @default(uuid()) @db.Uuid
  statementId         String               @map("statement_id") @db.Uuid
  externalId          String               @unique @map("external_id") @db.VarChar(64)
  bookedAt            DateTime             @map("booked_at") @db.Timestamptz(3)
  amount              Decimal              @db.Decimal(14, 2)
  currency            String               @default("USD") @db.Char(3)
  direction           TransactionDirection
  counterpartyName    String               @map("counterparty_name") @db.VarChar(200)
  counterpartyAccount String?              @map("counterparty_account") @db.VarChar(64)
  reference           String               @db.VarChar(300)
  matchStatus         PaymentMatchStatus   @default(UNMATCHED) @map("match_status")
  matchedOrderId      String?              @map("matched_order_id") @db.Uuid
  matchedById         String?              @map("matched_by_id") @db.Uuid
  matchedAt           DateTime?            @map("matched_at") @db.Timestamptz(3)
  version             Int                  @default(1)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  statement           BankStatement        @relation(fields: [statementId], references: [id], onDelete: Cascade)
  matchedOrder        Order?               @relation(fields: [matchedOrderId], references: [id], onDelete: SetNull)
  matchedBy           User?                @relation("TransactionMatcher", fields: [matchedById], references: [id], onDelete: SetNull)

  @@index([statementId, bookedAt])
  @@index([matchStatus, bookedAt])
  @@index([matchedOrderId])
  @@index([bookedAt])
  @@map("bank_transactions")
}
