{
  "name": "practice-crm-nodejs-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Навчальна CRM API на Express.js і TypeScript",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "clean": "rimraf dist coverage",
    "prisma": "node scripts/run-prisma.mjs",
    "prisma:validate": "npm run prisma -- validate",
    "prisma:generate": "npm run prisma -- generate",
    "db:migrate": "npm run prisma -- migrate dev",
    "db:migrate:deploy": "npm run prisma -- migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "generate": "npm run prisma:generate",
    "migrate": "npm run db:migrate",
    "seed": "npm run db:seed",
    "build": "npm run clean && npm run prisma:generate && tsc -p tsconfig.build.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:integration": "node scripts/test/run-integration.mjs",
    "test:watch": "jest --watch",
    "ci": "npm run prisma:validate && npm run prisma:generate && npm run lint && npm run format && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "dotenv": "17.2.3",
    "express": "5.1.0",
    "express-rate-limit": "8.6.2",
    "helmet": "8.3.0",
    "ioredis": "5.6.1",
    "jsonwebtoken": "9.0.2",
    "mongoose": "9.9.2",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "rate-limit-redis": "6.0.1",
    "swagger-jsdoc": "6.3.0",
    "swagger-ui-express": "5.0.1",
    "ws": "8.21.3",
    "zod": "4.1.13"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@swc/core": "1.15.11",
    "@swc/jest": "0.2.39",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.5",
    "@types/jest": "30.0.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "22.20.1",
    "@types/supertest": "6.0.3",
    "@types/swagger-jsdoc": "6.0.4",
    "@types/swagger-ui-express": "4.1.8",
    "@types/ws": "8.18.1",
    "eslint": "9.39.1",
    "jest": "30.2.0",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.6",
    "prisma": "6.19.3",
    "rimraf": "6.1.3",
    "supertest": "7.1.4",
    "tsx": "4.23.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.0"
  }
}
